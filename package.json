{
  "name": "juniper-sql-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "spike:chromium": "npm run build && node scripts/engine-spike.mjs chromium",
    "spike:webkit": "npm run build && node scripts/engine-spike.mjs webkit",
    "browsers:install": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium webkit",
    "test:e2e": "npm run build && PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "test:e2e:chromium": "npm run test:e2e -- --project=chromium"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
